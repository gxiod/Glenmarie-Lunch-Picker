# Copy to `.env` for local `netlify dev`. NEVER commit the real .env — it is in
# .gitignore. On the deployed site, set this in Netlify → Site settings →
# Environment variables instead (do NOT ship a key in the repo).
#
# Get a free Foursquare Places key (no credit card):
#   https://location.foursquare.com/developer/  → create a project → copy the
#   Service API Key.
FOURSQUARE_API_KEY=your_foursquare_service_api_key_here
